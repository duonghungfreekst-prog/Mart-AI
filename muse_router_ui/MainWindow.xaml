<Window x:Class="MuseRouter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MuseRouter — Desktop Control Center &amp; Web Studio Launcher"
        Height="560"
        Width="860"
        WindowStartupLocation="CenterScreen"
        Background="#060711"
        Foreground="#F3F5FF">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0D1021" BorderBrush="#2694A3D6" BorderThickness="1" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Muse AI Multi-Account Router" FontSize="22" FontWeight="Bold" Foreground="#F3F5FF"/>
                    <TextBlock Text="Kiến trúc Antigravity Polyglot: C# UI → Go Engine → Python AI Bridge → Rust Core Vault"
                               FontSize="13" Foreground="#B5BDDB" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenWebStudio"
                            Content="🌐 Mở Web Tool (127.0.0.1:8088)"
                            Padding="16,10"
                            Background="#9333EA"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnOpenWebStudio_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Telemetry Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,16,0,16">
            <Border Background="#0D1021" BorderBrush="#2694A3D6" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TỔNG TOKENS TRONG POOL" FontSize="11" Foreground="#7E88AD" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtTokensRemain" Text="0" FontSize="22" FontWeight="Bold" Foreground="#22D3EE" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#0D1021" BorderBrush="#2694A3D6" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="NODE ĐANG CHẠY (RUNNING)" FontSize="11" Foreground="#7E88AD" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtRunningNodes" Text="0" FontSize="22" FontWeight="Bold" Foreground="#C084FC" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#0D1021" BorderBrush="#2694A3D6" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="NODE SẴN SÀNG (READY)" FontSize="11" Foreground="#7E88AD" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtReadyNodes" Text="0" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#0D1021" BorderBrush="#2694A3D6" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="TỔNG SỐ NODE TRONG POOL" FontSize="11" Foreground="#7E88AD" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtTotalNodes" Text="0" FontSize="22" FontWeight="Bold" Foreground="#F3F5FF" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Status & Log View -->
        <Border Grid.Row="2" Background="#0D1021" BorderBrush="#2694A3D6" BorderThickness="1" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Nhật ký điều phối &amp; Trạng thái kết nối Go Engine" FontSize="14" FontWeight="SemiBold" Foreground="#E9D5FF" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtActivityLog"
                         Grid.Row="1"
                         Background="#04050C"
                         Foreground="#B5BDDB"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="12.5"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnRefreshStatus"
                    Content="🔄 Làm mới Telemetry"
                    Padding="14,8"
                    Margin="0,0,10,0"
                    Background="#141830"
                    Foreground="#F3F5FF"
                    BorderBrush="#2694A3D6"
                    Cursor="Hand"
                    Click="BtnRefreshStatus_Click"/>
        </StackPanel>
    </Grid>
</Window>
