{
  "manifest_version": 3,
  "name": "Mart AI — Tự Động Bắt & Đồng Bộ Muse.ai",
  "version": "1.1.0",
  "description": "Tự động bắt phiên đăng nhập muse.ai (HttpOnly hatch_sess) và thực thi Chat thật đa tài khoản trên Cloud/Render.",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "https://mart-ai.onrender.com/*",
    "http://127.0.0.1:8088/*",
    "http://localhost:8088/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://mart-ai.onrender.com/*",
      "http://127.0.0.1:8088/*",
      "http://localhost:8088/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mart AI — Tự Động Bắt & Đồng Bộ Muse.ai"
  }
}
