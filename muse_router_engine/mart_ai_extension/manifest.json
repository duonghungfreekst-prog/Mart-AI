{
  "manifest_version": 3,
  "name": "Mart AI — Tự Động Bắt & Đồng Bộ Muse.ai",
  "version": "1.2.6",
  "description": "Tự động bắt phiên đăng nhập muse.ai (HttpOnly hatch_sess) 0 chạm và thực thi Chat thật đa tài khoản trên Cloud/Render.",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "https://mart-ai.onrender.com/*",
    "https://*.onrender.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mart-ai.onrender.com/*",
        "https://*.onrender.com/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://mart-ai.onrender.com/*",
      "https://*.onrender.com/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mart AI — Tự Động Bắt & Đồng Bộ Muse.ai"
  }
}
