{
  "manifest_version": 3,
  "name": "Mart AI — Tự Động Bắt Tài Khoản Muse",
  "version": "1.0.0",
  "description": "Tự động bắt phiên đăng nhập muse.ai (kể cả HttpOnly hatch_sess) và đồng bộ 1 chạm về Mart AI.",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://muse.ai/*",
    "https://*.muse.ai/*",
    "https://mart-ai.onrender.com/*",
    "http://127.0.0.1:8088/*",
    "http://localhost:8088/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://mart-ai.onrender.com/*",
      "http://127.0.0.1:8088/*",
      "http://localhost:8088/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mart AI — Tự Động Bắt Tài Khoản Muse"
  }
}
